# Copy to .env and replace the local development secrets before running.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-local-password
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://localhost:8000

CITIZEN_MCP_PUBLIC_URL=http://localhost:8100/mcp

OFFICER_MCP_PUBLIC_URL=http://localhost:8200/mcp
# JSON map: OAuth officer username -> list of exact authorized block names.
OFFICER_BLOCK_ASSIGNMENTS={"admin":["Sonari"]}
# Optional JSON map for additional distinct officer OAuth logins; keep real values in secrets.
OFFICER_ACCOUNTS_JSON={}
